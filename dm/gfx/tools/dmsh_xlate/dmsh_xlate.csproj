<!-- Switch 著色器 → SPIR-V 翻譯工具。引用倉內收錄的 Ryujinx 著色器翻譯庫源碼（dm/third_party/ryujinx）；可用 -p:RyuSrc=<目錄> 指到別的一份。 -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 只帶英文語系資源：依賴（Humanizer）預設會把幾十種語系的資源一起發佈出來 | ship English resources only: the dependencies (Humanizer) would otherwise publish dozens of locale resources -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../../../third_party/ryujinx</RyuSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
  <!-- 嵌入自身源碼：參數 source-sha 報出，dmsh_chain.py 核對翻譯器是用倉內源編的 -->
  <ItemGroup>
    <EmbeddedResource Include="Program.cs" LogicalName="src0" />
    <EmbeddedResource Include="dmsh_xlate.csproj" LogicalName="src1" />
  </ItemGroup>
</Project>
